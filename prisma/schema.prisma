generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// ICP (Ideal Customer Profile)
// ==========================================

model IcpProfile {
  id              String   @id @default(cuid())
  name            String
  industries      String   @default("[]") // JSON array
  companySizeMin  Int?
  companySizeMax  Int?
  locations       String   @default("[]") // JSON array
  technologies    String   @default("[]") // JSON array
  fundingStages   String   @default("[]") // JSON array
  revenueMin      Int?
  revenueMax      Int?
  keywords        String   @default("[]") // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies Company[]
}

// ==========================================
// Company
// ==========================================

model Company {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  industry        String   @default("")
  employeeCount   Int      @default(0)
  employeeRange   String   @default("")
  location        String   @default("")
  country         String   @default("")
  website         String   @default("")
  logoUrl         String?
  fundingStage    String   @default("")
  fundingAmount   Int?
  lastFundingDate String?
  technologies    String   @default("[]") // JSON array
  enrichedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matchedIcpId String?
  matchedIcp   IcpProfile? @relation(fields: [matchedIcpId], references: [id])

  // Enrichment — Google Business
  googleRating      Float?
  googleReviewCount Int?
  reviewSentiment   String? // positive, mixed, negative

  // Enrichment — Website Analysis
  crmDetected       String? // none, basic, full
  crmName           String?
  websiteQuality    Int?    // 0-100
  hasSsl            Boolean @default(false)
  hasIdx            Boolean @default(false)
  siteAge           String?
  techStack         String  @default("[]") // JSON array

  contacts Contact[]
  news     CompanyNews[]

  @@index([industry])
  @@index([matchedIcpId])
}

model CompanyNews {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  source      String   @default("")
  url         String   @default("")
  publishedAt String   @default("")
  snippet     String   @default("")
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// ==========================================
// Contact
// ==========================================

model Contact {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  fullName      String
  title         String   @default("")
  department    String   @default("")
  photoUrl      String?
  workEmail     String?
  personalEmail String?
  workPhone     String?
  personalPhone String?
  linkedinUrl   String?
  facebookUrl   String?
  instagramUrl  String?
  enrichedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Validation
  emailStatus       String   @default("unverified") // unverified, verified, risky, invalid, email_missing
  emailConfidence   Int      @default(0)
  emailSource       String   @default("scraped") // scraped, discovered, imported
  validatedAt       DateTime?

  // Lead scoring
  leadScore         Int      @default(0) // 0-100
  leadTier          String   @default("cold") // hot, warm, cold
  icpFitScore       Int      @default(0) // 0-40
  timingScore       Int      @default(0) // 0-30
  dataQualityScore  Int      @default(0) // 0-30
  scoredAt          DateTime?

  // Pipeline status
  contactStatus     String   @default("new") // new, contacted, replied, converted, opted_out
  suppressedAt      DateTime?
  suppressReason    String?
  lastContactedAt   DateTime?

  articles       ContactArticle[]
  emails         Email[]
  validationLogs ValidationLog[]
  enrichment     EnrichmentData?

  @@index([companyId])
  @@index([workEmail])
  @@index([emailStatus])
  @@index([leadTier])
  @@index([contactStatus])
}

model ContactArticle {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title       String
  source      String   @default("")
  url         String   @default("")
  publishedAt String   @default("")
  snippet     String   @default("")
  createdAt   DateTime @default(now())

  @@index([contactId])
}

// ==========================================
// Validation & Enrichment
// ==========================================

model ValidationLog {
  id            String   @id @default(cuid())
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  email         String
  // Layer 1 — Syntax
  syntaxValid   Boolean  @default(false)
  isDisposable  Boolean  @default(false)
  isRoleBased   Boolean  @default(false)
  // Layer 2 — DNS / MX
  dnsValid      Boolean  @default(false)
  mxExists      Boolean  @default(false)
  isCatchAll    Boolean  @default(false)
  // Layer 3 — SMTP
  smtpValid     Boolean? // null = inconclusive
  smtpResponse  String?
  // Layer 4 — Cross-Reference
  provider1Name   String?
  provider1Result String? // deliverable, risky, invalid, unknown
  provider2Name   String?
  provider2Result String?
  // Result
  confidence    Int      @default(0)
  status        String   @default("pending") // pending, pass, risky, fail
  createdAt     DateTime @default(now())

  @@index([contactId])
  @@index([email])
}

model EnrichmentData {
  id              String   @id @default(cuid())
  contactId       String   @unique
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Google Business Profile
  googleRating      Float?
  googleReviewCount Int?
  recentReviews     String   @default("[]") // JSON array
  reviewSentiment   String?
  hoursUpdated      Boolean?
  hasPhotos         Boolean?
  googleCategory    String?
  googleLocation    String?

  // Website Analysis
  hasWebsite        Boolean  @default(false)
  crmDetected       String?  // none, basic, full
  crmName           String?
  websiteQuality    Int?
  hasSsl            Boolean  @default(false)
  hasIdx            Boolean  @default(false)
  siteAge           String?
  techStack         String   @default("[]") // JSON array

  // Social & Professional
  fbPageUrl         String?
  fbFollowers       Int?
  fbPostFrequency   String?  // high, medium, low, none
  igFollowers       Int?
  igPostFrequency   String?
  ytHasChannel      Boolean  @default(false)
  ytVideoCount      Int?
  linkedinHeadline  String?
  linkedinConnections Int?

  // Business Signals & Hooks
  signals           String   @default("[]") // JSON: [{ type, description, severity, source }]
  hooks             String   @default("[]") // JSON: [{ text, signal, sourceUrl }]
  leadPriority      String?  // HIGH, MEDIUM, LOW

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==========================================
// Email Outreach
// ==========================================

model Email {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  subject      String
  body         String
  status       String    @default("draft") // draft, scheduled, sent, opened, replied, bounced
  sentAt       DateTime?
  openedAt     DateTime?
  repliedAt    DateTime?
  bouncedAt    DateTime?
  scheduledFor DateTime?
  sequenceId   String?
  sequence     EmailSequence? @relation(fields: [sequenceId], references: [id])
  sequenceStep Int?
  trackingId   String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contactId])
  @@index([sequenceId])
  @@index([status])
  @@index([trackingId])
}

model EmailSequence {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("draft") // draft, active, paused, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps             SequenceStep[]
  emails            Email[]
  enrolledContacts  SequenceEnrollment[]
}

model SequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  delayDays  Int           @default(0)
  subject    String
  body       String
  type       String        @default("follow-up") // initial, follow-up, breakup
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([sequenceId])
  @@unique([sequenceId, order])
}

model SequenceEnrollment {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  currentStep Int          @default(0)
  status     String        @default("active") // active, paused, completed, bounced
  nextSendAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([sequenceId, contactId])
  @@index([sequenceId])
  @@index([nextSendAt])
}

// ==========================================
// Settings
// ==========================================

model Settings {
  id             String  @id @default("default")
  smtpHost       String  @default("")
  smtpPort       Int     @default(587)
  smtpUser       String  @default("")
  smtpPass       String  @default("")
  fromEmail      String  @default("")
  fromName       String  @default("")
  dailySendLimit Int     @default(5)
  aiApiKey       String  @default("")
  aiProvider     String  @default("anthropic")
  // Validation & Enrichment API keys
  neverBounceKey    String  @default("")
  zeroBounceKey     String  @default("")
  builtWithKey      String  @default("")
  googlePlacesKey   String  @default("")
}

// ==========================================
// Scrape Jobs
// ==========================================

model ScrapeJob {
  id          String   @id @default(cuid())
  icpId       String?
  status      String   @default("pending") // pending, running, completed, failed
  type        String   @default("company_discovery") // company_discovery, contact_enrichment, news_scan, validation, enrichment, full_pipeline
  query       String   @default("")
  results     String   @default("{}") // JSON results summary
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([icpId])
}
